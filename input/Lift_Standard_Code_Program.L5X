</Parameters>
<LocalTags/>
<Routines>
<Routine Name="Logic" Type="ST">
<Description>
<![CDATA[Monitors a signal to see if it's in a given range.  Tolerance is +/- and symmetrical.]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
<Line Number="1">
<![CDATA[Hi := Signal >= LimitHi;]]>
</Line>
<Line Number="2">
<![CDATA[Lo := Signal <= LimitLo;]]>
</Line>
<Line Number="3">
<![CDATA[InRange := NOT Hi AND NOT Lo;]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>

<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[If Port is active IO-Link mode, verify correct device is connected.]]>
</Comment>
<Text>
<![CDATA[XIC(IO_Link_Port_Data.Inputs[32].0)XIC(IO_Link_Port_Data.Inputs[32].1)XIO(IO_Link_Port_Data.Inputs[33].0)EQU(IO_Link_Port_Data.Inputs[34],3)EQU(IO_Link_Port_Data.Inputs[35],120)EQU(IO_Link_Port_Data.Inputs[36],5)EQU(IO_Link_Port_Data.Inputs[37],11)LEQ(IO_Link_Port_Data.Inputs[38],4)OTE(Data_Diag.DeviceOK);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Error indication if connected device is not correct.]]>
</Comment>
<Text>
<![CDATA[XIC(IO_Link_Port_Data.Inputs[32].0)XIC(IO_Link_Port_Data.Inputs[32].1)XIO(IO_Link_Port_Data.Inputs[33].0)[NEQ(IO_Link_Port_Data.Inputs[36],5) ,NEQ(IO_Link_Port_Data.Inputs[37],11) ,GRT(IO_Link_Port_Data.Inputs[38],4) ,NEQ(IO_Link_Port_Data.Inputs[34],3) ,NEQ(IO_Link_Port_Data.Inputs[35],120) ]OTE(Data_Diag.MismatchFault);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[COP(IO_Link_Port_Data.Inputs[34],Data_Diag.VendorID[0],2)COP(IO_Link_Port_Data.Inputs[36],Data_Diag.DeviceID[0],3);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Error indication if no device connected.]]>
</Comment>
<Text>
<![CDATA[XIC(IO_Link_Port_Data.Inputs[32].0)XIO(IO_Link_Port_Data.Inputs[32].1)OTE(Data_Diag.CommFault);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(IO_Link_Port_Data.Inputs[33].0)OTE(Data_Diag.ValidationFailed);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(IO_Link_Port_Data.Inputs[33].1)OTE(Data_Diag.DSValidationFailure);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(IO_Link_Port_Data.Inputs[33].2)OTE(Data_Diag.ProcessDataInvalid);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(IO_Link_Port_Data.Inputs[33].7)OTE(Data_Diag.IOLShortCircuit);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[The next 3 rungs map the 3 most recent Event Codes]]>
</Comment>
<Text>
<![CDATA[MOV(IO_Link_Port_Data.Inputs[39],Data_Diag.Event[0].Code)MOV(IO_Link_Port_Data.Inputs[40],Mapped_BNI007Z_Data.IOL_Diag.Event[0].Additional_Data_1)MOV(IO_Link_Port_Data.Inputs[41],Mapped_BNI007Z_Data.IOL_Diag.Event[0].Additional_Data_2);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[MOV(IO_Link_Port_Data.Inputs[42],Mapped_BNI007Z_Data.IOL_Diag.Event[1].Code)MOV(IO_Link_Port_Data.Inputs[43],Mapped_BNI007Z_Data.IOL_Diag.Event[1].Additional_Data_1)MOV(IO_Link_Port_Data.Inputs[44],Mapped_BNI007Z_Data.IOL_Diag.Event[1].Additional_Data_2);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[MOV(IO_Link_Port_Data.Inputs[45],Mapped_BNI007Z_Data.IOL_Diag.Event[2].Code)MOV(IO_Link_Port_Data.Inputs[46],Mapped_BNI007Z_Data.IOL_Diag.Event[2].Additional_Data_1)MOV(IO_Link_Port_Data.Inputs[47],Mapped_BNI007Z_Data.IOL_Diag.Event[2].Additional_Data_2);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[
The next 16 rungs map the raw input data to defined Parameters.
]]>
</Comment>
<Text>
<![CDATA[XIC(IO_Link_Port_Data.Inputs[0].0)OTE(Inputs.0);]]>
</Text>
</Rung>

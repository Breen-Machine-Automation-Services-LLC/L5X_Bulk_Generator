# --- Python Bytecode and Cache ---
# These are compiled Python files that are generated automatically.
__pycache__/
*.pyc
*.pyo
*.pyd


# --- Virtual Environments ---
# Never commit your virtual environment.
venv/
.venv/
env/
.env


# --- Build & Distribution Artifacts ---
# These are generated when you build a distributable package.
build/
dist/
*.egg-info/


# --- Testing & Coverage ---
# These are generated by testing tools like pytest and coverage.
.pytest_cache/
.coverage
htmlcov/
*.cov


# --- IDE & Editor Directories ---
# Ignore configuration files from common editors.
# The leading slash ensures it only matches in the root directory.
/.vscode/*
!.vscode/launch.json
/.idea/
/.github/*


# --- Log and Data Files ---
# Ignore log files and other runtime-generated files.
*.log
*.log.*
*.logs


# --- Project-Specific Ignores ---
# The rules below are tailored to YOUR project structure.

# Ignore all generated files in the output data folder,
# but DO NOT ignore the .gitkeep file, so the folder still exists.
output/*
!/output/.gitkeep

# Ignore all experimental files in the sandbox directory,
# but keep the directory itself.
/sandbox/*
!/sandbox/.gitkeep
/reference/*
!/reference/.gitkeep

# Ignore third-party dependencies in the vendor directory,
# but keep the directory itself.
/vendor/*
!/vendor/.gitkeep
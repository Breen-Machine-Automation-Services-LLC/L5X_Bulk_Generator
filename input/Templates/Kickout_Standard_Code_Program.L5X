<Routine Name="_XXXX_Data" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Straight Track Standard Code v2.0
-------------------------------------------------------
Station XXXX Data
-------------------------------------------------------
MES and Data Collection]]>
</Comment>

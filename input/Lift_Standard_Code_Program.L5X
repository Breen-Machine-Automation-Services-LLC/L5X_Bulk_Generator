<Programs Use="Context">
<Program Use="Target" Name="Lift_Standard_Code" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false" Class="Standard" UseAsFolder="false">
<Tags/>
<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[JSR(_XXXX_Data,0) ,JSR(_XXXX_Outputs,0) ,JSR(_XXXX_States,0) ,JSR(_XXXX_Status,0) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_XXXX_Data" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Lift Standard Code v2.1 
-------------------------------------------------------
Station XXXX Data
-------------------------------------------------------
MES and Data Collection]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Machine Stats for HMI, Andon]]>
</Comment>
<Text>
<![CDATA[[EQU(State_WaitingForPart,LiXXXX.State) MOV(1,FiSZ_BI_XXXX_MachineStats.PLC_MachineState) ,EQU(State_Infeeding,LiXXXX.State) MOV(2,FiSZ_BI_XXXX_MachineStats.PLC_MachineState) ,[EQU(State_MovingMinWork,LiXXXX.State) EQU(0,LiXXXX_Work_Positions_Index) ,EQU(State_MovingToWork,LiXXXX.State) EQU(0,LiXXXX_Work_Positions_Index) ,EQU(State_MovingMinInfeed,LiXXXX.State) ,EQU(State_MovingToInfeed,LiXXXX.State) ,EQU(State_MovingMinOutfeed,LiXXXX.State) ,EQU(State_MovingToOutfeed,LiXXXX.State) ] MOV(3,FiSZ_BI_XXXX_MachineStats.PLC_MachineState) ,EQU(State_WaitingForOperator,LiXXXX.State) MOV(4,FiSZ_BI_XXXX_MachineStats.PLC_MachineState) ,EQU(State_WaitingForDownstream,LiXXXX.State) MOV(5,FiSZ_BI_XXXX_MachineStats.PLC_MachineState) ,EQU(State_Outfeeding,LiXXXX.State) MOV(6,FiSZ_BI_XXXX_MachineStats.PLC_MachineState) ,EQU(Sys_Mode_Manual,LiXXXX.Mode) MOV(28,FiSZ_BI_XXXX_MachineStats.PLC_MachineState) ,EQU(Sys_Mode_CycleStopped,LiXXXX.Mode) MOV(29,FiSZ_BI_XXXX_MachineStats.PLC_MachineState) ,NEQ(0,LiXXXX.Error) MOV(30,FiSZ_BI_XXXX_MachineStats.PLC_MachineState) ,XIO(Safety_PowerOn_Placeholder.DN) MOV(31,FiSZ_BI_XXXX_MachineStats.PLC_MachineState) ,MOV(LiXXXX.Warning,FiSZ_BI_XXXX_MachineStats.PLC_Warning) MOV(LiXXXX.Error,FiSZ_BI_XXXX_MachineStats.PLC_Fault) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_XXXX_Outputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Lift Standard Code v2.1 
-------------------------------------------------------
Station XXXX Outputs
-------------------------------------------------------
This routine contains logic to control the outputs of Station XXXX.]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Output:
Run conveyor
Output Triggers:
1. Infeeding state
2. Outfeeding state
3. Manual mode
Output Permissives:
1a. Lift height is in range for infeed
1b. Stop photoeye is clear
2a. Lift height is in range for outfeed
2b. Downstream station conevyor is running
3. HMI conveyor jog forward or reverse pushbutton]]>
</Comment>
<Text>
<![CDATA[XIC(Safety_PowerOn_Placeholder.DN)[EQU(Sys_Mode_CycleStarted,LiXXXX.Mode) [EQU(State_Infeeding,LiXXXX.State) XIC(LiXXXX_Lift_Infeed.InRange) XIO(LiXXXX_PE_FE) ,EQU(State_Outfeeding,LiXXXX.State) XIC(LiXXXX_Lift_Outfeed.InRange) XIC(STZZZZ_Conv_Run) XIC(Outfeed_InPosition_Placeholder) ] ,EQU(Sys_Mode_Manual,LiXXXX.Mode) [XIC(LiXXXX_Conv_Fwd_HMI) ,XIC(LiXXXX_Conv_Rev_HMI) XIC(LiXXXX_Conv_Dir) ] ]OTE(LiXXXX_Conv_Run);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Output:
Conveyor Direction
Output Triggers:
1. Manual mode
Output Permissives:
1. HMI coneyor jog reverse pushbutton]]>
</Comment>
<Text>
<![CDATA[XIC(Safety_PowerOn_Placeholder.DN)EQU(Sys_Mode_Manual,LiXXXX.Mode)XIC(LiXXXX_Conv_Rev_HMI)OTE(LiXXXX_Conv_Dir);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Output:
Actuate lift raise solenoids
Output Triggers:
1. Lift raise command
2. Waiting for operator state
3. Manual mode
Output Permissives:
1a. Lift height is less than Hi limit
1b. Actuate lift lower solenoids output not on
1c. HPU steady state timer not timer
2a. Lift jog up pushbutton
2b. Lift height is less than Hi limit
2c. Actuate lift lower solenoids output not on
2d. HPU steady state timer not timer
3a. HMI raise lift pushbutton
3b. Lift jog up pushbutton
3c. HMI move lift to target pushbutton
]]>
</Comment>
<Text>
<![CDATA[XIC(Safety_PowerOn_Placeholder.DN)[EQU(Sys_Mode_CycleStarted,LiXXXX.Mode) [XIC(LiXXXX_Lift_Up) ,EQU(State_WaitingForOperator,LiXXXX.State) XIC(LiXXXX_PB_JogUp) ] ,EQU(Sys_Mode_Manual,LiXXXX.Mode) [XIC(LiXXXX_Lift_Up_HMI) ,XIC(LiXXXX_PB_JogUp) ,XIC(LiXXXX_Lift_Run_HMI) XIC(LiXXXX_Lift_Up) ] ]LES(LiXXXX_Lift_Inclinometer.Degrees,LiXXXX_Lift_Hi)XIO(LiXXXX_Lift_Down_Valves)XIO(LiXXXX_HPU_Hold.TT)OTE(LiXXXX_Lift_Up_Valves);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Output:
Actuate lift lower solenoids
Output Triggers:
1. Lift lower command
2. Waiting for operator state
3. Manual mode
Output Permissives:
1a. Lift height is greater than Lo limit
1b. Actuate lift raise solenoids output not on
1c. HPU steady state timer not timing
2a. Lift jog down pushbutton
2b. Lift height is greater than Lo limit
2c. Actuate lift raise solenoids output not on
2d. HPU steady state timer not timer
3a. HMI lower lift pushbutton
3b. Lift jog down pushbutton
3c. HMI move lift to target pushbutton
]]>
</Comment>
<Text>
<![CDATA[XIC(Safety_PowerOn_Placeholder.DN)[EQU(Sys_Mode_CycleStarted,LiXXXX.Mode) [XIC(LiXXXX_Lift_Down) ,EQU(State_WaitingForOperator,LiXXXX.State) XIC(LiXXXX_PB_JogDown) ] ,EQU(Sys_Mode_Manual,LiXXXX.Mode) [XIC(LiXXXX_Lift_Down_HMI) ,XIC(LiXXXX_PB_JogDown) ,XIC(LiXXXX_Lift_Run_HMI) XIC(LiXXXX_Lift_Down) ] ]GRT(LiXXXX_Lift_Inclinometer.Degrees,LiXXXX_Lift_Lo)XIO(LiXXXX_Lift_Up_Valves)XIO(LiXXXX_HPU_Hold.TT)OTE(LiXXXX_Lift_Down_Valves);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[HPU steady state timer
Allows the lift to settle at steady state before moving or checking heights]]>
</Comment>
<Text>
<![CDATA[XIC(Safety_PowerOn_Placeholder.DN)[XIC(LiXXXX_Lift_Up_Valves) ,XIC(LiXXXX_Lift_Down_Valves) ]TOF(LiXXXX_HPU_Hold,?,?);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Output:
Lift Solenoids
Output Permissives:
1a. Hydraulic pump running
1b. Station gap photoeyes are clear
1c. Actuate lift raise solenoids
2a. Statoin gap photoeyes are clear
2b. Actuate lift lower solenoids
]]>
</Comment>
<Text>
<![CDATA[XIC(Safety_PowerOn_Placeholder.DN)[XIC(LiXXXX_HPU_Run) XIC(LiXXXX_LiftClear) XIC(LiXXXX_Lift_Up_Valves) OTE(LiXXXX_SV1) ,XIC(LiXXXX_LiftClear) XIC(LiXXXX_Lift_Down_Valves) OTE(LiXXXX_SV2) OTE(LiXXXX_SV3) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Output:
Run hydraulic pump
Output Permissives:
1a. Actuate lift raise solenoids
1b. HPU hold on timer timing
2. Hydraulic pump disconnect on
3. HPU hold off timer not timing
4. Station gap photoeyes are clear
HPU hold on/off timers are used to help the contiunous rated hydraulic pump motor operate in a non-continuous function.
]]>
</Comment>
<Text>
<![CDATA[XIC(Safety_PowerOn_Placeholder.DN)[XIC(LiXXXX_Lift_Up_Valves) RES(LiXXXX_HPU_Hold_On) ,XIC(LiXXXX_HPU_Hold_On.TT) ]XIC(LiXXXX_HPU_Disc)XIO(LiXXXX_HPU_Hold_Off.TT)XIC(LiXXXX_LiftClear)[OTE(LiXXXX_HPU_Run) ,TON(LiXXXX_HPU_Hold_On,?,?) ,TOF(LiXXXX_HPU_Hold_Off,?,?) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Output:
Reset hydraulic pump motor starter
Output Permissives:
1. An active error on the hydraulic pump motor starter
2. HMI fault reset pushbutton
]]>
</Comment>
<Text>
<![CDATA[XIC(LiXXXX_HPU_Error)XIC(Sys_Alm_Reset_HMI)OTE(LiXXXX_HPU_Reset);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Output:
Release Push Button Light
Output Triggers:
1. Blink when waiting for operator press
2. Solid when waiting to outfeed or when outfeeding]]>
</Comment>
<Text>
<![CDATA[[EQU(State_WaitingForOperator,LiXXXX.State) XIC(MES_FFFFF_XXXX.Data.UpstreamOK) XIC(Sys_Slow_Blink) ,[EQU(State_WaitingForDownstream,LiXXXX.State) ,EQU(State_Outfeeding,LiXXXX.State) ] ]OTE(LiXXXX_Release_Lt);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_XXXX_States" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Lift Standard Code v2.1
-------------------------------------------------------
Station XXXX States
-------------------------------------------------------
This routine contains logic to control the state of station XXXX. The general function of this station is:
1. Infeed part from YYYY
2. Move lift to work height
3. Operator works on part
4. Move lift to unload height
5. Outfeed part to ZZZZ
6. Move lift to load height
]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State: 
Waiting to infeed part from upstream station
Next State Conditions: 
1. Stop photoeye is clear
2a. Lift height is in range for infeed
2b. Lift height is not in range for infeed
Next State:
a. Infeeding part from upstream station
b. Checking if a minimum move is needed to get to the infeed height 
]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,LiXXXX.Mode)EQU(State_WaitingForPart,LiXXXX.State)EQU(State_WaitingForDownstream,STYYYY.State)XIO(LiXXXX_PE_FE)[XIC(LiXXXX_Lift_Infeed.InRange) MOV(State_Infeeding,LiXXXX.State) ,XIO(LiXXXX_Lift_Infeed.InRange) MOV(State_MovingMinInfeed,LiXXXX.State) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[State: 
Infeeding part from upstream station
Next State Conditions: 
1. Stop photoeye is blocked
2. Infeeding steady state timer is done
3a. Station is an active workstation
3b. Station is not an active workstation
Next State:
a. Checking if a minimum move is needed to get to the work height 
b. Checking if a minimum move is needed to get to the outfeed height 
]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,LiXXXX.Mode)EQU(State_Infeeding,LiXXXX.State)XIC(LiXXXX_PE_FE)TON(LiXXXX_Infeeding_TON,?,?)XIC(LiXXXX_Infeeding_TON.DN)[XIC(LiXXXX_SW_Active) MOV(State_MovingMinWork,LiXXXX.State) ,XIO(LiXXXX_SW_Active) MOV(State_MovingMinOutfeed,LiXXXX.State) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[State: 
Checking if a minimum move is needed to get to the work height 
Next State Conditions: 
1. HPU steady state time is done
2a. Lift height is in range for temp work
2b. Lift height is in range for work
Next State: 
Moving lift to work height
]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,LiXXXX.Mode)EQU(State_MovingMinWork,LiXXXX.State)XIO(LiXXXX_HPU_Hold.DN)[XIC(LiXXXX_Lift_Work_Temp.InRange) ,XIC(LiXXXX_Lift_Work.InRange) ]MOV(State_MovingToWork,LiXXXX.State);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State: 
Moving lift to work height
Next State Conditions: 
1. HPU steady state timer is done
2. Lift height is in range for work
Next State:
Operator working on part
]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,LiXXXX.Mode)EQU(State_MovingToWork,LiXXXX.State)XIO(LiXXXX_HPU_Hold.DN)XIC(LiXXXX_Lift_Work.InRange)MOV(State_WaitingForOperator,LiXXXX.State);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State: 
Operator working on part
Next State Conditions: 
1. Release steady state timer is done
2. MES is ok to release
3a. Station is an active workstation and the release pushbutton is pressed
3b. Station is not an active workstation
Next State:
Checking if a minimum move is needed to get to the outfeed height, 
send feedback to MES that part is releasing
]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,LiXXXX.Mode)EQU(State_WaitingForOperator,LiXXXX.State)TON(LiXXXX_Release_TON,?,?)XIC(LiXXXX_Release_TON.DN)[XIC(MES_FFFFF_XXXX.Data.UpstreamOK) OTE(MES_FFFFF_XXXX.OK) ,[XIC(LiXXXX_SW_Active) XIC(LiXXXX_PB_Release) ,XIO(LiXXXX_SW_Active) ] [XIC(LiXXXX_Work_Positions_CTU.DN) XIC(MES_FFFFF_XXXX.Data.UpstreamOK) MOV(State_MovingMinOutfeed,LiXXXX.State) ,XIO(LiXXXX_Work_Positions_CTU.DN) [MOV(State_MovingMinWork,LiXXXX.State) ,CTU(LiXXXX_Work_Positions_CTU,?,?) ] ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[State: 
Checking if a minimum move is needed to get to the outfeed height
Next State Conditions: 
1. HPU steady state time is done
2a. Lift height is in range for temp outfeed
2b. Lift height is in range for outfeed
Next State:
Moving lift to outfeed height
]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,LiXXXX.Mode)EQU(State_MovingMinOutfeed,LiXXXX.State)XIO(LiXXXX_HPU_Hold.DN)[XIC(LiXXXX_Lift_Outfeed_Temp.InRange) ,XIC(LiXXXX_Lift_Outfeed.InRange) ]MOV(State_MovingToOutfeed,LiXXXX.State);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[State: 
Moving lift to outfeed height
Next State Conditions: 
1. HPU steady state timer is done
2. Lift height is in range for outfeed
Next State:
Waiting to outfeed part to downstream station]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,LiXXXX.Mode)EQU(State_MovingToOutfeed,LiXXXX.State)XIO(LiXXXX_HPU_Hold.DN)XIC(LiXXXX_Lift_Outfeed.InRange)MOV(State_WaitingForDownstream,LiXXXX.State);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[State: 
Waiting to outfeed part to downstream station
Next State Conditions: 
1. Stop photoeye is blocked
2. Downstream station is in the infeeding state
3a. Lift height is in range for outfeed
3b. Lift height is not in range for outfeed
Next State:
a. Outfeeding part to downstream station, 
send feedback to MES that part is released
b. Checking if a minimum move is needed to get to the outfeed height]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,LiXXXX.Mode)EQU(State_WaitingForDownstream,LiXXXX.State)XIC(LiXXXX_PE_FE)EQU(State_Infeeding,STZZZZ.State)[XIC(LiXXXX_Lift_Outfeed.InRange) [MOV(State_Outfeeding,LiXXXX.State) ,OTL(MES_FFFFF_XXXX.DN) ] ,XIO(LiXXXX_Lift_Outfeed.InRange) MOV(State_MovingMinOutfeed,LiXXXX.State) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[State: 
Outfeeding part to downstream station
Next State Conditions: 
1. Stop photoeye is clear
2. Outfeeding steady state timer is done
Next State:
Checking if a minimum move is needed to get to the infeed height]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,LiXXXX.Mode)EQU(State_Outfeeding,LiXXXX.State)XIO(LiXXXX_PE_FE)XIC(Outfeed_Complete_Placeholder)TON(LiXXXX_Outfeeding_TON,?,?)XIC(LiXXXX_Outfeeding_TON.DN)MOV(State_MovingMinInfeed,LiXXXX.State);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[State: 
Checking if a minimum move is needed to get to the infeed height
Next State Conditions: 
1. HPU steady state time is done
2a. Lift height is in range for temp infeed
2b. Lift height is in range for infeed
Next State:
Moving lift to infeed height]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,LiXXXX.Mode)EQU(State_MovingMinInfeed,LiXXXX.State)XIO(LiXXXX_HPU_Hold.DN)[XIC(LiXXXX_Lift_Infeed_Temp.InRange) ,XIC(LiXXXX_Lift_Infeed.InRange) ]MOV(State_MovingToInfeed,LiXXXX.State);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[State: 
Moving lift to infeed height
Next State Conditions: 
1. HPU steady state timer is done
2. Lift height is in range for infeed
Next State:
Waiting to infeed part from upstream station]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,LiXXXX.Mode)EQU(State_MovingToInfeed,LiXXXX.State)XIO(LiXXXX_HPU_Hold.DN)XIC(LiXXXX_Lift_Infeed.InRange)[MOV(State_WaitingForPart,LiXXXX.State) ,RES(LiXXXX_Work_Positions_CTU) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_XXXX_Status" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Lift Standard Code v2.1
-------------------------------------------------------
Station XXXX Status
-------------------------------------------------------
Inputs and Configuration]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Configuration bits for lift stations
Turn on if functionality exists
If configuration bit is not listed, it is marked as spare and available for use]]>
</Comment>
<Text>
<![CDATA[XIC(LiXXXX.Config.5)XIC(LiXXXX.Config.6)XIC(LiXXXX.Config.10)XIC(LiXXXX.Config.11)XIC(LiXXXX.Config.20)XIC(LiXXXX.Config.21)XIC(LiXXXX.Config.22)XIC(LiXXXX.Config.23)XIC(LiXXXX.Config.30)NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[HMI Destination/Route Interface]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_Manual,LiXXXX.Mode)XIC(LiXXXX_Accept_Manual_Route_HMI)MOV(LiXXXX_Manual_Route_HMI,LiXXXX_Route);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Needed for standard HMI level 2 display parameter passing]]>
</Comment>
<Text>
<![CDATA[[XIC(LiXXXX_PE_FE) ,XIC(LiXXXX_PE_RE) ]OTE(LiXXXX_PE_SE);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Status bit to indicate if all station photoeyes are clear]]>
</Comment>
<Text>
<![CDATA[XIO(LiXXXX_PE_FE)XIO(LiXXXX_PE_RE)XIC(LiXXXX_PE_UT)XIC(LiXXXX_PE_OT)OTE(LiXXXX_EyesClear);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Status bit to indicate if all overtravel/undertravel/gap photoeyes are clear
OT/UT is determined based on station FE/RE position]]>
</Comment>
<Text>
<![CDATA[XIC(LiXXXX_PE_UT)XIC(LiXXXX_PE_OT)XIO(CTXXXX_Px_Blade_Down)XIC(CTXXXX_Px_Blade_Up)OTE(LiXXXX_LiftClear);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[HMI state descriptions]]>
</Comment>
<Text>
<![CDATA[[MOV(99,LiXXXX_State_Desc_Idx) ,EQU(State_WaitingForPart,LiXXXX.State) MOV(0,LiXXXX_State_Desc_Idx) ,EQU(State_Infeeding,LiXXXX.State) MOV(1,LiXXXX_State_Desc_Idx) ,[EQU(State_MovingMinWork,LiXXXX.State) ,EQU(State_MovingToWork,LiXXXX.State) ] MOV(21,LiXXXX_State_Desc_Idx) ,EQU(State_WaitingForOperator,LiXXXX.State) MOV(10,LiXXXX_State_Desc_Idx) ,[EQU(State_MovingMinOutfeed,LiXXXX.State) ,EQU(State_MovingToOutfeed,LiXXXX.State) ] MOV(22,LiXXXX_State_Desc_Idx) ,EQU(State_WaitingForDownstream,LiXXXX.State) MOV(2,LiXXXX_State_Desc_Idx) ,EQU(State_Outfeeding,LiXXXX.State) MOV(3,LiXXXX_State_Desc_Idx) ,[EQU(State_MovingMinInfeed,LiXXXX.State) ,EQU(State_MovingToInfeed,LiXXXX.State) ] MOV(20,LiXXXX_State_Desc_Idx) ,NEQ(State_Desc_HMI[LiXXXX_State_Desc_Idx],LiXXXX_State_Desc_HMI) MOV(State_Desc_HMI[LiXXXX_State_Desc_Idx],LiXXXX_State_Desc_HMI) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Cycle stop logic
Cycle start logic (station must have no active errors)
Manual mode logic]]>
</Comment>
<Text>
<![CDATA[[XIC(LiXXXX.Stop_HMI) MOV(Sys_Mode_CycleStopped,LiXXXX.Mode) ,[XIC(LiXXXX.Start_HMI) ,XIC(Group_Cycle_Start) NEQ(Sys_Mode_Manual,LiXXXX.Mode) ] EQU(LiXXXX.Error,0) MOV(Sys_Mode_CycleStarted,LiXXXX.Mode) ,XIC(LiXXXX.Manual_HMI) MOV(Sys_Mode_Manual,LiXXXX.Mode) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[ HMI set state to checking if a minimum move is need to get to the infeed height 
1. HMI force empty pushbutton
2. Stop photoeye is clear
 HMI set state to checking if a minimum move is need to get to the work height 
1. HMI force occupied pushbutton
2. Stop photoeye is blocked
3. Station is an active workstation
 HMI set state to checking if a minimum move is need to get to the outfeed height 
1. HMI force occupied pushbutton
2. Stop photoeye is blocked
3. Station is not an active workstation]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_Manual,LiXXXX.Mode)[XIC(LiXXXX.SetState_PartClear_HMI) XIO(LiXXXX_PE_FE) [MOV(State_MovingMinInfeed,LiXXXX.State) ,RES(LiXXXX_Work_Positions_CTU) ] ,XIC(LiXXXX.SetState_PartPresent_HMI) XIC(LiXXXX_PE_FE) [XIC(LiXXXX_SW_Active) MOV(State_MovingMinWork,LiXXXX.State) ,XIO(LiXXXX_SW_Active) MOV(State_MovingMinOutfeed,LiXXXX.State) ,RES(LiXXXX_Work_Positions_CTU) ] ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Lift inclinometer senor
Used to read current height of lift]]>
</Comment>
<Text>
<![CDATA[SZG_IOL_Inclinometer(LiXXXX_Lift_Inclinometer,IOL_XXXX_PX.Inputs,IOL_XXXX_PX.Outputs);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Lift infeed height
Set Lo/Hi infeed height limits
Set target infeed height]]>
</Comment>
<Text>
<![CDATA[InRange_Asymmetric(LiXXXX_Lift_Infeed,LiXXXX_Lift_Inclinometer.Degrees,0,0,0);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Check if the distance needed to move to infeed height is less than the minimum required move distance
If yes:
1.. Check if the infeed target is greater or less than the midpoint to determine which way to move
2. Update the temp infeed target to be the acutal infeed targert +/- the constant offset
If no:
1. Update the temp infeed target to be the current lift height]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,LiXXXX.Mode)EQU(State_MovingMinInfeed,LiXXXX.State)ONS(LiXXXX_Lift_Infeed_MinMoveCalc_ONS)[SUB(LiXXXX_Lift_Inclinometer.Degrees,LiXXXX_Lift_Infeed.Target,LiXXXX_Lift_InfeedTarget_Diff) ,LIM(LiXXXX_Lift_MinMove_Neg,LiXXXX_Lift_InfeedTarget_Diff,LiXXXX_Lift_MinMove_Pos) [GRT(LiXXXX_Lift_Infeed.Target,LiXXXX_Lift_Midpoint) SUB(LiXXXX_Lift_Infeed.Target,LiXXXX_Lift_TargetOffest,LiXXXX_Lift_Infeed_TempTarget) ,LEQ(LiXXXX_Lift_Infeed.Target,LiXXXX_Lift_Midpoint) ADD(LiXXXX_Lift_Infeed.Target,LiXXXX_Lift_TargetOffest,LiXXXX_Lift_Infeed_TempTarget) ] ,LIM(LiXXXX_Lift_MinMove_Pos,LiXXXX_Lift_InfeedTarget_Diff,LiXXXX_Lift_MinMove_Neg) MOV(LiXXXX_Lift_Inclinometer.Degrees,LiXXXX_Lift_Infeed_TempTarget) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[ADD(LiXXXX_Lift_Infeed_TempTarget,1,LiXXXX_Lift_Infeed_Temp.LimitHi)SUB(LiXXXX_Lift_Infeed_TempTarget,1,LiXXXX_Lift_Infeed_Temp.LimitLo)InRange_Asymmetric(LiXXXX_Lift_Infeed_Temp,LiXXXX_Lift_Inclinometer.Degrees,LiXXXX_Lift_Infeed_Temp.LimitHi,LiXXXX_Lift_Infeed_TempTarget,LiXXXX_Lift_Infeed_Temp.LimitLo);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Lift work height
Set Lo/Hi work height limits
Set target work height
Update work height target if manually changed by operator]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_Manual,LiXXXX.Mode)LIM(1,LiXXXX_Work_Positions_HMI,5)XIC(LiXXXX_Accept_Work_Positions_HMI)SUB(LiXXXX_Work_Positions_HMI,1,LiXXXX_Work_Positions_CTU.PRE);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[NEQ(Sys_Mode_Manual,LiXXXX.Mode)ADD(LiXXXX_Work_Positions_CTU.PRE,1,LiXXXX_Work_Positions_HMI);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[[GEQ(LiXXXX_Work_Positions_CTU.PRE,4) MOV(4,LiXXXX_Work_Positions_CTU.PRE) ,LEQ(LiXXXX_Work_Positions_CTU.PRE,0) MOV(0,LiXXXX_Work_Positions_CTU.PRE) ,LIM(0,LiXXXX_Work_Positions_CTU.PRE,4) MOV(LiXXXX_Work_Positions_CTU.ACC,LiXXXX_Work_Positions_Index) ];]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[[EQU(Sys_Mode_CycleStarted,LiXXXX.Mode) EQU(State_WaitingForOperator,LiXXXX.State) XIO(LiXXXX_Lift_Work.InRange) MOV(LiXXXX_Lift_Inclinometer.Degrees,LiXXXX_Lift_Work_Positions[LiXXXX_Work_Positions_Index]) ,ADD(LiXXXX_Lift_Work_Positions[LiXXXX_Work_Positions_Index],1,LiXXXX_Lift_Work.LimitHi) SUB(LiXXXX_Lift_Work_Positions[LiXXXX_Work_Positions_Index],1,LiXXXX_Lift_Work.LimitLo) InRange_Asymmetric(LiXXXX_Lift_Work,LiXXXX_Lift_Inclinometer.Degrees,LiXXXX_Lift_Work.LimitHi,LiXXXX_Lift_Work_Positions[LiXXXX_Work_Positions_Index],LiXXXX_Lift_Work.LimitLo) ,NEQ(LiXXXX_Lift_Work_HMI,LiXXXX_Lift_Work_Positions[LiXXXX_Work_Positions_Index]) XIC(LiXXXX_Accept_Work_Positions_HMI) MOV(LiXXXX_Lift_Work_HMI,LiXXXX_Lift_Work_Positions[LiXXXX_Work_Positions_Index]) ];]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Check if the distance needed to move to work height is less than the minimum required move distance
If yes:
1.. Check if the work target is greater or less than the midpoint to determine which way to move
2. Update the temp work target to be the acutal work targert +/- the constant offset
If no:
1. Update the temp work target to be the current lift height]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,LiXXXX.Mode)EQU(State_MovingMinWork,LiXXXX.State)ONS(LiXXXX_Lift_Work_MinMoveCalc_ONS)[SUB(LiXXXX_Lift_Inclinometer.Degrees,LiXXXX_Lift_Work.Target,LiXXXX_Lift_WorkTarget_Diff) ,LIM(LiXXXX_Lift_MinMove_Neg,LiXXXX_Lift_WorkTarget_Diff,LiXXXX_Lift_MinMove_Pos) [GRT(LiXXXX_Lift_Work.Target,LiXXXX_Lift_Midpoint) SUB(LiXXXX_Lift_Work.Target,LiXXXX_Lift_TargetOffest,LiXXXX_Lift_Work_TempTarget) ,LEQ(LiXXXX_Lift_Work.Target,LiXXXX_Lift_Midpoint) ADD(LiXXXX_Lift_Work.Target,LiXXXX_Lift_TargetOffest,LiXXXX_Lift_Work_TempTarget) ] ,LIM(LiXXXX_Lift_MinMove_Pos,LiXXXX_Lift_WorkTarget_Diff,LiXXXX_Lift_MinMove_Neg) MOV(LiXXXX_Lift_Inclinometer.Degrees,LiXXXX_Lift_Work_TempTarget) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[ADD(LiXXXX_Lift_Work_TempTarget,1,LiXXXX_Lift_Work_Temp.LimitHi)SUB(LiXXXX_Lift_Work_TempTarget,1,LiXXXX_Lift_Work_Temp.LimitLo)InRange_Asymmetric(LiXXXX_Lift_Work_Temp,LiXXXX_Lift_Inclinometer.Degrees,LiXXXX_Lift_Work_Temp.LimitHi,LiXXXX_Lift_Work_TempTarget,LiXXXX_Lift_Work_Temp.LimitLo);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Lift outfeed height
Set Lo/Hi outfeed height limits
Set target outfeed height]]>
</Comment>
<Text>
<![CDATA[InRange_Asymmetric(LiXXXX_Lift_Outfeed,LiXXXX_Lift_Inclinometer.Degrees,0,0,0);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Comment>
<![CDATA[Check if the distance needed to move to outfeed height is less than the minimum required move distance
If yes:
1.. Check if the outfeed target is greater or less than the midpoint to determine which way to move
2. Update the temp outfeed target to be the acutal outfeed targert +/- the constant offset
If no:
1. Update the temp outfeed target to be the current lift height]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,LiXXXX.Mode)EQU(State_MovingMinOutfeed,LiXXXX.State)ONS(LiXXXX_Lift_Outfeed_MinMoveCalc_ONS)[SUB(LiXXXX_Lift_Inclinometer.Degrees,LiXXXX_Lift_Outfeed.Target,LiXXXX_Lift_OutfeedTarget_Diff) ,LIM(LiXXXX_Lift_MinMove_Neg,LiXXXX_Lift_OutfeedTarget_Diff,LiXXXX_Lift_MinMove_Pos) [GRT(LiXXXX_Lift_Outfeed.Target,LiXXXX_Lift_Midpoint) SUB(LiXXXX_Lift_Outfeed.Target,LiXXXX_Lift_TargetOffest,LiXXXX_Lift_Outfeed_TempTarget) ,LEQ(LiXXXX_Lift_Outfeed.Target,LiXXXX_Lift_Midpoint) ADD(LiXXXX_Lift_Outfeed.Target,LiXXXX_Lift_TargetOffest,LiXXXX_Lift_Outfeed_TempTarget) ] ,LIM(LiXXXX_Lift_MinMove_Pos,LiXXXX_Lift_OutfeedTarget_Diff,LiXXXX_Lift_MinMove_Neg) MOV(LiXXXX_Lift_Inclinometer.Degrees,LiXXXX_Lift_Outfeed_TempTarget) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[ADD(LiXXXX_Lift_Outfeed_TempTarget,1,LiXXXX_Lift_Outfeed_Temp.LimitHi)SUB(LiXXXX_Lift_Outfeed_TempTarget,1,LiXXXX_Lift_Outfeed_Temp.LimitLo)InRange_Asymmetric(LiXXXX_Lift_Outfeed_Temp,LiXXXX_Lift_Inclinometer.Degrees,LiXXXX_Lift_Outfeed_Temp.LimitHi,LiXXXX_Lift_Outfeed_TempTarget,LiXXXX_Lift_Outfeed_Temp.LimitLo);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Comment>
<![CDATA[Move the infeed/work/outfeed temp targets and targets to the lift target depending on current state
Turn on the lift run command]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,LiXXXX.Mode)[EQU(State_MovingMinInfeed,LiXXXX.State) MOV(LiXXXX_Lift_Infeed_TempTarget,LiXXXX_Lift_Target) ,EQU(State_MovingToInfeed,LiXXXX.State) MOV(LiXXXX_Lift_Infeed.Target,LiXXXX_Lift_Target) ,EQU(State_MovingMinWork,LiXXXX.State) MOV(LiXXXX_Lift_Work_TempTarget,LiXXXX_Lift_Target) ,EQU(State_MovingToWork,LiXXXX.State) MOV(LiXXXX_Lift_Work.Target,LiXXXX_Lift_Target) ,EQU(State_MovingMinOutfeed,LiXXXX.State) MOV(LiXXXX_Lift_Outfeed_TempTarget,LiXXXX_Lift_Target) ,EQU(State_MovingToOutfeed,LiXXXX.State) MOV(LiXXXX_Lift_Outfeed.Target,LiXXXX_Lift_Target) ]XIO(LiXXXX_Lift_DN)OTE(LiXXXX_Lift_Run);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[Find the distance required to get to the current lift target]]>
</Comment>
<Text>
<![CDATA[SUB(LiXXXX_Lift_Target,LiXXXX_Lift_Inclinometer.Degrees,LiXXXX_Lift_DistanceToTarget);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[If the lift moved down and the distance required to get to the target is greater than or equal to the down deadband the lift is done 
If the lift moved up and the distance required to get to the target is less than or equal to the up deadband the lift is done moving
If the lift hasn't moved and the distance required to get to the target is between both deadband limits the lift is done moving
If the distance required to get to the target is less than 0 command the lift to move down
If the distance required to get to the target is greater than 0 command the lift to move up]]>
</Comment>
<Text>
<![CDATA[[XIC(LiXXXX_Lift_Run) ,EQU(Sys_Mode_Manual,LiXXXX.Mode) XIC(LiXXXX_Lift_Run_HMI) ][[XIC(LiXXXX_Lift_Down) GEQ(LiXXXX_Lift_DistanceToTarget,LiXXXX_Lift_Down_Deadband) ,XIC(LiXXXX_Lift_Up) LEQ(LiXXXX_Lift_DistanceToTarget,LiXXXX_Lift_Up_Deadband) ,XIO(LiXXXX_Lift_Down) XIO(LiXXXX_Lift_Up) LIM(LiXXXX_Lift_Down_Deadband,LiXXXX_Lift_DistanceToTarget,LiXXXX_Lift_Up_Deadband) ,XIC(LiXXXX_Lift_DN) ] OTE(LiXXXX_Lift_DN) ,XIO(LiXXXX_Lift_DN) LES(LiXXXX_Lift_DistanceToTarget,0) OTE(LiXXXX_Lift_Down) ,XIO(LiXXXX_Lift_DN) GRT(LiXXXX_Lift_DistanceToTarget,0) OTE(LiXXXX_Lift_Up) ];]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Comment>
<![CDATA[Clear station faults and warnings with the HMI fault reset pushbutton]]>
</Comment>
<Text>
<![CDATA[XIC(Sys_Alm_Reset_HMI)[CLR(LiXXXX.Error) ,CLR(LiXXXX.Warning) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[If there is an active fault cycle stop the station]]>
</Comment>
<Text>
<![CDATA[NEQ(LiXXXX.Error,0)EQU(Sys_Mode_CycleStarted,LiXXXX.Mode)MOV(Sys_Mode_CycleStopped,LiXXXX.Mode);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[Station faults]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[XIO(Safety_PowerOn_Placeholder.DN)OTL(LiXXXX.Error.0);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,LiXXXX.Mode)EQU(State_WaitingForPart,LiXXXX.State)XIC(LiXXXX_PE_FE)TON(LiXXXX_Part_Found_Flt,?,?)XIC(LiXXXX_Part_Found_Flt.DN)OTL(LiXXXX.Error.1);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,LiXXXX.Mode)LIM(State_MovingMinWork,LiXXXX.State,State_WaitingForDownstream)XIO(LiXXXX_PE_FE)TON(LiXXXX_Part_Lost_Flt,?,?)XIC(LiXXXX_Part_Lost_Flt.DN)OTL(LiXXXX.Error.2);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,LiXXXX.Mode)EQU(State_Infeeding,LiXXXX.State)XIC(LiXXXX_Conv_Run)TON(LiXXXX_Part_Load_Flt,?,?)XIC(LiXXXX_Part_Load_Flt.DN)OTL(LiXXXX.Error.3);]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[XIC(IOLMaster_Connection_Faulted_Placeholder)OTL(LiXXXX.Error.5);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Text>
<![CDATA[XIC(LiXXXX_HPU_Error)OTL(LiXXXX.Error.10);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Text>
<![CDATA[XIC(LiXXXX_Lift_Inclinometer.ER)OTL(LiXXXX.Error.11);]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Text>
<![CDATA[LIM(LiXXXX_Lift_HiHi,LiXXXX_Lift_Inclinometer.Degrees,LiXXXX_Lift_LoLo)TON(LiXXXX_Lift_Flt,?,?)XIC(LiXXXX_Lift_Flt.DN)OTL(LiXXXX.Error.12);]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Text>
<![CDATA[[EQU(State_Infeeding,LiXXXX.State) XIO(LiXXXX_PE_OT) ,EQU(State_Outfeeding,LiXXXX.State) XIO(LiXXXX_PE_UT) ,NEQ(State_Infeeding,LiXXXX.State) NEQ(State_Outfeeding,LiXXXX.State) XIO(LiXXXX_LiftClear) ]TON(LiXXXX_Gap_Eye_Flt,?,?)XIC(LiXXXX_Gap_Eye_Flt.DN)OTL(LiXXXX.Error.15);]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Comment>
<![CDATA[Station warnings]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Text>
<![CDATA[XIC(LiXXXX.Start_HMI)NEQ(LiXXXX.Error,0)OTL(LiXXXX.Warning.0);]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Text>
<![CDATA[EQU(Sys_Mode_Manual,LiXXXX.Mode)XIC(LiXXXX.SetState_PartClear_HMI)XIC(LiXXXX_PE_FE)OTL(LiXXXX.Warning.1);]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Text>
<![CDATA[EQU(Sys_Mode_Manual,LiXXXX.Mode)XIC(LiXXXX.SetState_PartPresent_HMI)XIO(LiXXXX_PE_FE)OTL(LiXXXX.Warning.2);]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
<Text>
<![CDATA[XIO(LiXXXX_HPU_Disc)OTL(LiXXXX.Warning.10);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>

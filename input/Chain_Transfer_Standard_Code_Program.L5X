<Programs Use="Context">
<Program Use="Target" Name="Chain_Transfer_Standard_Code" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false" Class="Standard" UseAsFolder="false">
<Tags/>
<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[JSR(_XXXX_Data,0) ,JSR(_XXXX_Outputs,0) ,JSR(_XXXX_States,0) ,JSR(_XXXX_Status,0) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_XXXX_Data" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Chain Transfer Standard Code v2.0
-------------------------------------------------------
Station XXXX Data
-------------------------------------------------------
MES and Data Collection]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Machine Stats for HMI, Andon]]>
</Comment>
<Text>
<![CDATA[[EQU(State_WaitingForPart,CTXXXX.State) MOV(1,FiSZ_BI_XXXX_MachineStats.PLC_MachineState) ,[EQU(State_InfeedingConveyorForward,CTXXXX.State) ,EQU(State_InfeedingConveyorReverse,CTXXXX.State) ,EQU(State_InfeedingChainForward,CTXXXX.State) ,EQU(State_InfeedingChainReverse,CTXXXX.State) ] MOV(2,FiSZ_BI_XXXX_MachineStats.PLC_MachineState) ,EQU(State_MovingToWork,CTXXXX.State) MOV(3,FiSZ_BI_XXXX_MachineStats.PLC_MachineState) ,EQU(State_WaitingForOperator,CTXXXX.State) MOV(4,FiSZ_BI_XXXX_MachineStats.PLC_MachineState) ,EQU(State_WaitingForDownstream,CTXXXX.State) MOV(5,FiSZ_BI_XXXX_MachineStats.PLC_MachineState) ,[EQU(State_OutfeedingChainForward,CTXXXX.State) ,EQU(State_OutfeedingChainReverse,CTXXXX.State) ,EQU(State_OutfeedingConveyorForward,CTXXXX.State) ,EQU(State_OutfeedingConveyorReverse,CTXXXX.State) ] MOV(6,FiSZ_BI_XXXX_MachineStats.PLC_MachineState) ,EQU(Sys_Mode_Manual,CTXXXX.Mode) MOV(28,FiSZ_BI_XXXX_MachineStats.PLC_MachineState) ,EQU(Sys_Mode_CycleStopped,CTXXXX.Mode) MOV(29,FiSZ_BI_XXXX_MachineStats.PLC_MachineState) ,NEQ(0,CTXXXX.Error) MOV(30,FiSZ_BI_XXXX_MachineStats.PLC_MachineState) ,XIO(Safety_PowerOn_Placeholder.DN) MOV(31,FiSZ_BI_XXXX_MachineStats.PLC_MachineState) ,MOV(CTXXXX.Warning,FiSZ_BI_XXXX_MachineStats.PLC_Warning) MOV(CTXXXX.Error,FiSZ_BI_XXXX_MachineStats.PLC_Fault) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_XXXX_Outputs" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Chain Transfer Standard Code v2.0
-------------------------------------------------------
Station XXXX Outputs
-------------------------------------------------------
This routine contains logic to control the outputs of Station XXXX.]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Output:
Run conveyor
Output Triggers:
1a. Infeeding from conveyor forward state
1b. Infeeding from conveyor reverse state
1c. Outfeeding to conveyor forward state
1d. Outfeeding to conveyor reverse state
2. Manual mode
Output Permissives:
1a. Conveyor forward photoeye is clear
1b. Conveyor reverse photoeye is clear
1c. Conveyor forward station is running
1d. Conveyor reverse station is running
2. HMI conveyor jog forward or reverse pushbutton
3. The transfer lift is down]]>
</Comment>
<Text>
<![CDATA[XIC(Safety_PowerOn_Placeholder.DN)[EQU(Sys_Mode_CycleStarted,CTXXXX.Mode) [EQU(State_InfeedingConveyorForward,CTXXXX.State) XIO(CTXXXX_FE_Conv) ,EQU(State_InfeedingConveyorReverse,CTXXXX.State) XIO(CTXXXX_RE_Conv) XIC(CTXXXX_Conv_Dir) ,EQU(State_OutfeedingConveyorForward,CTXXXX.State) XIC(STZZZZ_Conv_Run) XIC(Outfeed_InPosition_Placeholder) ,EQU(State_OutfeedingConveyorReverse,CTXXXX.State) XIC(CTXXXX_Conv_Dir) XIC(STYYYY_Conv_Run) XIC(Outfeed_InPosition_Placeholder) ] ,EQU(Sys_Mode_Manual,CTXXXX.Mode) [XIC(CTXXXX_Conv_Fwd_HMI) ,XIC(CTXXXX_Conv_Rev_HMI) XIC(CTXXXX_Conv_Dir) ] ]XIC(CTXXXX_Px_Transfer_Down)XIO(CTXXXX_Px_Transfer_Up)OTE(CTXXXX_Conv_Run);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Output:
Conveyor Direction
Output Triggers:
1a. Infeeding from conveyor reverse state
1b. Outfeeding to conveyor reverse state
2. Manual mode
Output Permissives:
1a. Conveyor reverse photoeye is clear
1b. Conveyor reverse station is running
2. HMI conveyor jog reverse pushbutton
3. The transfer lift is down]]>
</Comment>
<Text>
<![CDATA[XIC(Safety_PowerOn_Placeholder.DN)[EQU(Sys_Mode_CycleStarted,CTXXXX.Mode) [EQU(State_InfeedingConveyorReverse,CTXXXX.State) XIO(CTXXXX_RE_Conv) ,EQU(State_OutfeedingConveyorReverse,CTXXXX.State) XIC(STYYYY_Conv_Run) ] ,EQU(Sys_Mode_Manual,CTXXXX.Mode) XIC(CTXXXX_Conv_Rev_HMI) ]XIC(CTXXXX_Px_Transfer_Down)XIO(CTXXXX_Px_Transfer_Up)OTE(CTXXXX_Conv_Dir);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Output:
Run chain
Output Triggers:
1a. Infeeding from chain forward state
1b. Infeeding from chain reverse state
1c. Outfeeding to chain forward state
1d. Outfeeding to chain reverse state
2. Manual mode
Output Permissives:
1a. Chain forward photoeye is clear
1b. Chain reverse photoeye is clear
1c. Chain forward station is running
1d. Chain reverse station is running
2. HMI chain jog forward or reverse pushbutton
3. The transfer lift is up]]>
</Comment>
<Text>
<![CDATA[XIC(Safety_PowerOn_Placeholder.DN)[EQU(Sys_Mode_CycleStarted,CTXXXX.Mode) [EQU(State_InfeedingChainForward,CTXXXX.State) XIO(CTXXXX_FE_Chain) ,EQU(State_InfeedingChainReverse,CTXXXX.State) XIO(CTXXXX_RE_Chain) ,EQU(State_OutfeedingChainForward,CTXXXX.State) XIC(STWWWW_Conv_Run) ,EQU(State_OutfeedingChainReverse,CTXXXX.State) XIC(STVVVV_Conv_Run) ] ,EQU(Sys_Mode_Manual,CTXXXX.Mode) [XIC(CTXXXX_Chain_Fwd_HMI) ,XIC(CTXXXX_Chain_Rev_HMI) ] ]XIO(CTXXXX_Px_Transfer_Down)XIC(CTXXXX_Px_Transfer_Up)OTE(CTXXXX_Chain_Run);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Output:
Chain Direction
Output Triggers:
1a. Infeeding from chain reverse state
1b. Outfeeding to chain reverse state
2. Manual mode
Output Permissives:
1a. Chain reverse photoeye is clear
1b. Chain reverse station is running
2. HMI chain jog reverse pushbutton
3. The transfer lift is up]]>
</Comment>
<Text>
<![CDATA[XIC(Safety_PowerOn_Placeholder.DN)[EQU(Sys_Mode_CycleStarted,CTXXXX.Mode) [EQU(State_InfeedingChainReverse,CTXXXX.State) XIO(CTXXXX_RE_Chain) ,EQU(State_OutfeedingChainReverse,CTXXXX.State) XIC(STVVVV_Conv_Run) ] ,EQU(Sys_Mode_Manual,CTXXXX.Mode) XIC(CTXXXX_Chain_Rev_HMI) ]XIO(CTXXXX_Px_Transfer_Down)XIC(CTXXXX_Px_Transfer_Up)OTE(CTXXXX_Chain_Dir);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Output:
Transfer Raise
Output Triggers:
1. Station is cycle stopped
2a. Infeeding from chain forward state
2b. Infeeding from chain reverse state
2c. Outfeeding to chain forward state
2d. Outfeeding to chain reverse state
3. Manual mode
Output Permissives:
1. Transfer is already up
3.  HMI transfer raise pushbutton]]>
</Comment>
<Text>
<![CDATA[XIC(Safety_PowerOn_Placeholder.DN)[EQU(Sys_Mode_CycleStopped,CTXXXX.Mode) XIC(CTXXXX_Px_Transfer_Up) ,EQU(Sys_Mode_CycleStarted,CTXXXX.Mode) [EQU(State_InfeedingChainForward,CTXXXX.State) ,EQU(State_InfeedingChainReverse,CTXXXX.State) ,EQU(State_OutfeedingChainForward,CTXXXX.State) ,EQU(State_OutfeedingChainReverse,CTXXXX.State) ] ,EQU(Sys_Mode_Manual,CTXXXX.Mode) [XIC(CTXXXX_Manual_Transfer_Raise) XIO(CTXXXX_Manual_Transfer_Lower) ,XIC(CTXXXX_Px_Transfer_Up) XIO(CTXXXX_Manual_Transfer_Lower) ] ]OTE(CTXXXX_Sol_Transfer_Up);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Output:
Release Push Button Light
Output Triggers:
1. Blink when waiting for operator press
2. Solid when waiting to outfeed or when outfeeding]]>
</Comment>
<Text>
<![CDATA[[EQU(State_WaitingForOperator,CTXXXX.State) XIC(MES_FFFFF_XXXX.Data.UpstreamOK) XIC(Sys_Slow_Blink) ,[EQU(State_WaitingForDownstream,CTXXXX.State) ,EQU(State_Outfeeding,CTXXXX.State) ] ]OTE(CTXXXX_Release_Lt);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_XXXX_States" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Chain Transfer Standard Code v2.0
-------------------------------------------------------
Station XXXX States
-------------------------------------------------------
This routine contains logic to control the state of station XXXX. The general function of this station is:
1. Infeed part from YYYY (conveyor forward), ZZZZ (conveyor reverse), VVVV (chain reverse), or WWWW (chain forward)
2. Operator works on the part
3. Outfeed part to station YYYY (conveyor reverse),  ZZZZ (conveyor forward), VVVV (chain forward), or WWWW (chain reverse)]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[State: 
Waiting to infeed part from conveyor forward/reverse or chain forward/reverse
Next State Conditions: 
1a. Conveyor forward station is waiting for downstream and infeed location equals conveyor forward station ID
1b. Conveyor reverse station is waiting for downstream and infeed location equals conveyor reverse station ID
1c. Chain forward station is waiting for downstream and infeed location equals chain forward station ID
1d. Chain reverse station is waiting for downstream and infeed location equals chain reverse station ID
2a. Forward conveyor photoeye is clear
2b. Reverse conveyor photoeye is clear
2c. Forward chain photoeye is clear
2d. Reverse chain photoeye is clear
Next State:
a. Infeeding part from conveyor forward station
b. Infeeding part from conveyor reverse station
c. Infeeding part from chain forward station
d. Infeeding part from chain reverse station
]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,CTXXXX.Mode)EQU(State_WaitingForPart,CTXXXX.State)[EQU(State_WaitingForDownstream,STYYYY.State) EQU(Sys_Infeed_Conv_Fwd_ID,CTXXXX_Infeed_Loc) XIO(CTXXXX_FE_Conv) MOV(State_InfeedingConveyorForward,CTXXXX.State) ,EQU(State_WaitingForDownstream,STZZZZ.State) EQU(Sys_Infeed_Conv_Rev_ID,CTXXXX_Infeed_Loc) XIO(CTXXXX_RE_Conv) MOV(State_InfeedingConveyorReverse,CTXXXX.State) ,EQU(State_WaitingForDownstream,STVVVV.State) EQU(Sys_Infeed_Chain_Fwd_ID,CTXXXX_Infeed_Loc) XIO(CTXXXX_FE_Chain) MOV(State_InfeedingChainForward,CTXXXX.State) ,EQU(State_WaitingForDownstream,STWWWW.State) EQU(Sys_Infeed_Chain_Rev_ID,CTXXXX_Infeed_Loc) XIO(CTXXXX_RE_Chain) MOV(State_InfeedingChainReverse,CTXXXX.State) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[State: 
Infeeding part from conveyor forward/reverse or chain forward/reverse
Next State Conditions: 
1a. Forward conveyor photoeye is blocked
1b. Reverse conveyor photoeye is blocked
1c. Forward chain photoeye is blocked
1d. Reverse chain photoeye is blocked
2. Infeeding steady state timer is done
3a. Station is an active workstation
3b. Station is not an active workstation
Next State:
a. Operator working on part
b. Waiting to outfeed part to downstream station
]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,CTXXXX.Mode)[EQU(State_InfeedingConveyorForward,CTXXXX.State) XIC(CTXXXX_FE_Conv) ,EQU(State_InfeedingConveyorReverse,CTXXXX.State) XIC(CTXXXX_RE_Conv) ,EQU(State_InfeedingChainForward,CTXXXX.State) XIC(CTXXXX_FE_Chain) ,EQU(State_InfeedingChainReverse,CTXXXX.State) XIC(CTXXXX_RE_Chain) ]TON(CTXXXX_Infeeding_TON,?,?)XIC(CTXXXX_Infeeding_TON.DN)[XIC(CTXXXX_Sw_Active) MOV(State_WaitingForOperator,CTXXXX.State) ,XIO(CTXXXX_Sw_Active) MOV(State_WaitingForDownstream,CTXXXX.State) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[State: 
Operator working on part
Next State Conditions: 
1a. Part was received from conveyor forward station and conveyor forward photoeye is blocked
1b. Part was received from conveyor reverse station and conveyor reverse photoeye is blocked
1c. Part was received from chain forward station and chain forward photoeye is blocked
1d. Part was received from chain reverse station and chain reverse photoeye is blocked
2. Release steady state timer is done
3. MES is ok to release
4a. Station is an active workstation and the release pushbutton is pressed
4b. Station is not an active workstation
Next State:
Waiting to outfeed part to downstream station, 
send feedback to MES that part is releasing
]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,CTXXXX.Mode)EQU(State_WaitingForOperator,CTXXXX.State)[EQU(Sys_Infeed_Conv_Fwd_ID,CTXXXX_Infeed_Loc) XIC(CTXXXX_FE_Conv) ,EQU(Sys_Infeed_Conv_Rev_ID,CTXXXX_Infeed_Loc) XIC(CTXXXX_RE_Conv) ,EQU(Sys_Infeed_Chain_Fwd_ID,CTXXXX_Infeed_Loc) XIC(CTXXXX_FE_Chain) ,EQU(Sys_Infeed_Chain_Rev_ID,CTXXXX_Infeed_Loc) XIC(CTXXXX_RE_Chain) ]TON(CTXXXX_Release_TON,?,?)XIC(CTXXXX_Release_TON.DN)XIC(MES_FFFFF_XXXX.Data.UpstreamOK)[OTE(MES_FFFFF_XXXX.OK) ,[XIC(CTXXXX_Sw_Active) XIC(CTXXXX_PB_Release) ,XIO(CTXXXX_Sw_Active) ] MOV(State_WaitingForDownstream,CTXXXX.State) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[State: 
Waiting to outfeed part to conveyor forward/reverse or chain forward/reverse station
Next State Conditions: 
1a. Part was received from conveyor forward station and conveyor forward photoeye is blocked
1b. Part was received from conveyor reverse station and conveyor reverse photoeye is blocked
1c. Part was received from chain forward station and chain forward photoeye is blocked
1d. Part was received from chain reverse station and chain reverse photoeye is blocked
2a. Outfeed location is equal to conveyor foward station ID and conveyor forward station is in the infeeding state
2b. Outfeed location is equal to conveyor reverse station ID and conveyor reverse station is in the infeeding state
2c. Outfeed location is equal to chain forward station ID and chain forward station is in the infeeding state
2d. Outfeed location is equal to chain reverse staiton ID and chain reverse station is in the infeeding state
Next State:
1a. Outfeeding part to conveyor forward station
1b. Outfeeding part to conveyor reverse station
1c. Outfeeding part to chain forward station
1d. Outfeeding part to chain reverse station
2. Send feedback to MES that part is released
]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,CTXXXX.Mode)EQU(State_WaitingForDownstream,CTXXXX.State)[EQU(Sys_Infeed_Conv_Fwd_ID,CTXXXX_Infeed_Loc) XIC(CTXXXX_FE_Conv) ,EQU(Sys_Infeed_Conv_Rev_ID,CTXXXX_Infeed_Loc) XIC(CTXXXX_RE_Conv) ,EQU(Sys_Infeed_Chain_Fwd_ID,CTXXXX_Infeed_Loc) XIC(CTXXXX_FE_Chain) ,EQU(Sys_Infeed_Chain_Rev_ID,CTXXXX_Infeed_Loc) XIC(CTXXXX_RE_Chain) ][EQU(Sys_Outfeed_Conv_Fwd_ID,CTXXXX_Outfeed_Dest) EQU(State_Infeeding,STZZZZ.State) MOV(State_OutfeedingConveyorForward,CTXXXX.State) ,EQU(Sys_Outfeed_Conv_Rev_ID,CTXXXX_Outfeed_Dest) EQU(State_Infeeding,STYYYY.State) MOV(State_OutfeedingConveyorReverse,CTXXXX.State) ,EQU(Sys_Outfeed_Chain_Fwd_ID,CTXXXX_Outfeed_Dest) EQU(State_Infeeding,STWWWW.State) MOV(State_OutfeedingChainForward,CTXXXX.State) ,EQU(Sys_Outfeed_Chain_Rev_ID,CTXXXX_Outfeed_Dest) EQU(State_Infeeding,STVVVV.State) MOV(State_OutfeedingChainReverse,CTXXXX.State) ]OTL(MES_FFFFF_XXXX.DN);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[State: 
Outfeeding part to conveyor forward/reverse or chain forward/reverse station
Next State Conditions: 
1a. Part outfeeding to conveyor forward station and conveyor forward photoeye is clear
1b. Part outfeeding to conveyor reverse station and conveyor reverse photoeye is clear
1c. Part outfeeding to chain forward station and chain forward photoeye is clear
1d. Part outfeeding to chain reverse station and chain reverse photoeye is clear
2. Outfeeding steady state timer is done
Next State:
Waiting to infeed part from conveyor forward/reverse or chain forward/reverse
]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,CTXXXX.Mode)[EQU(State_OutfeedingConveyorForward,CTXXXX.State) XIO(CTXXXX_FE_Conv) XIC(Outfeed_Complete_Placeholder) ,EQU(State_OutfeedingConveyorReverse,CTXXXX.State) XIO(CTXXXX_RE_Conv) XIC(Outfeed_Complete_Placeholder) ,EQU(State_OutfeedingChainForward,CTXXXX.State) XIO(CTXXXX_FE_Chain) XIC(Outfeed_Complete_Placeholder) ,EQU(State_OutfeedingChainReverse,CTXXXX.State) XIO(CTXXXX_FE_Chain) XIC(Outfeed_Complete_Placeholder) ]TON(CTXXXX_Outfeeding_TON,?,?)XIC(CTXXXX_Outfeeding_TON.DN)MOV(State_WaitingForPart,CTXXXX.State);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="_XXXX_Status" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Chain Transfer Standard Code v2.0
-------------------------------------------------------
Station XXXX Status
-------------------------------------------------------
Inputs and Configuration]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Configuration bits for chain transfer stations
Turn on if functionality exists
If configuration bit is not listed, it is marked as spare and available for use]]>
</Comment>
<Text>
<![CDATA[XIC(CTXXXX.Config.5)XIC(CTXXXX.Config.6)XIC(CTXXXX.Config.10)XIC(CTXXXX.Config.11)XIC(CTXXXX.Config.15)XIC(CTXXXX.Config.16)XIC(CTXXXX.Config.20)XIC(CTXXXX.Config.21)XIC(CTXXXX.Config.22)XIC(CTXXXX.Config.23)XIC(CTXXXX.Config.30)NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[HMI Destination/Route Interface]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_Manual,CTXXXX.Mode)XIC(CTXXXX_Accept_Manual_Route_HMI)MOV(CTXXXX_Manual_Route_HMI,CTXXXX_Route);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Needed for standard HMI level 2 display parameter passing]]>
</Comment>
<Text>
<![CDATA[[XIC(CTXXXX_FE_Conv) ,XIC(CTXXXX_RE_Conv) ,XIC(CTXXXX_FE_Chain) ,XIC(CTXXXX_RE_Chain) ]OTE(CTXXXX_PE_SE);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[HMI State Descriptions]]>
</Comment>
<Text>
<![CDATA[[MOV(99,CTXXXX_State_Desc_Idx) ,EQU(State_WaitingForPart,CTXXXX.State) MOV(0,CTXXXX_State_Desc_Idx) ,EQU(State_InfeedingConveyorForward,CTXXXX.State) MOV(50,CTXXXX_State_Desc_Idx) ,EQU(State_InfeedingConveyorReverse,CTXXXX.State) MOV(51,CTXXXX_State_Desc_Idx) ,EQU(State_InfeedingChainForward,CTXXXX.State) MOV(52,CTXXXX_State_Desc_Idx) ,EQU(State_InfeedingChainReverse,CTXXXX.State) MOV(53,CTXXXX_State_Desc_Idx) ,EQU(State_WaitingForOperator,CTXXXX.State) MOV(10,CTXXXX_State_Desc_Idx) ,EQU(State_WaitingForDownstream,CTXXXX.State) MOV(2,CTXXXX_State_Desc_Idx) ,EQU(State_OutfeedingConveyorForward,CTXXXX.State) MOV(54,CTXXXX_State_Desc_Idx) ,EQU(State_OutfeedingConveyorReverse,CTXXXX.State) MOV(55,CTXXXX_State_Desc_Idx) ,EQU(State_OutfeedingChainForward,CTXXXX.State) MOV(56,CTXXXX_State_Desc_Idx) ,EQU(State_OutfeedingChainReverse,CTXXXX.State) MOV(57,CTXXXX_State_Desc_Idx) ,NEQ(State_Desc_HMI[CTXXXX_State_Desc_Idx],CTXXXX_State_Desc_HMI) MOV(State_Desc_HMI[CTXXXX_State_Desc_Idx],CTXXXX_State_Desc_HMI) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Cycle stop logic
Cycle start logic (station must have no active errors)
Manual mode logic]]>
</Comment>
<Text>
<![CDATA[[XIC(CTXXXX.Stop_HMI) MOV(Sys_Mode_CycleStopped,CTXXXX.Mode) ,[XIC(CTXXXX.Start_HMI) ,XIC(Group_Cycle_Start) NEQ(Sys_Mode_Manual,CTXXXX.Mode) ] EQU(CTXXXX.Error,0) MOV(Sys_Mode_CycleStarted,CTXXXX.Mode) ,XIC(CTXXXX.Manual_HMI) MOV(Sys_Mode_Manual,CTXXXX.Mode) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[HMI set state to waiting to infeed part from conveyor forward/reverse or chain forward/reverse 
1. HMI force empty pushbutton
2. Conveyor forward, conveyor reverse, chain forward, and chain reverse photoeyes are clear
 HMI set state to operator working on part
1. HMI force occupied pushbutton
2. Conveyor forward, conveyor reverse, chain forward, or chain reverse photoeyes is blocked
3. Station is an active workstation
 HMI set state to waiting to outfeed part to conveyor forward/reverse or chain forward/reverse station
1. HMI force occupied pushbutton
2. Conveyor forward, conveyor reverse, chain forward, or chain reverse photoeyes is blocked
3. Station is not an active workstation
]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_Manual,CTXXXX.Mode)[XIC(CTXXXX.SetState_PartClear_HMI) XIO(CTXXXX_FE_Conv) XIO(CTXXXX_RE_Conv) XIO(CTXXXX_FE_Chain) XIO(CTXXXX_RE_Chain) MOV(State_WaitingForPart,CTXXXX.State) ,XIC(CTXXXX.SetState_PartPresent_HMI) [EQU(Sys_Infeed_Conv_Fwd_ID,CTXXXX_Infeed_Loc) XIC(CTXXXX_FE_Conv) ,EQU(Sys_Infeed_Conv_Rev_ID,CTXXXX_Infeed_Loc) XIC(CTXXXX_RE_Conv) ,EQU(Sys_Infeed_Chain_Fwd_ID,CTXXXX_Infeed_Loc) XIC(CTXXXX_FE_Chain) ,EQU(Sys_Infeed_Chain_Rev_ID,CTXXXX_Infeed_Loc) XIC(CTXXXX_RE_Chain) ] [XIC(CTXXXX_Sw_Active) MOV(State_WaitingForOperator,CTXXXX.State) ,XIO(CTXXXX_Sw_Active) MOV(State_WaitingForDownstream,CTXXXX.State) ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Reset infeed location and outfeed destination]]>
</Comment>
<Text>
<![CDATA[[EQU(State_OutfeedingConveyorForward,CTXXXX.State) ,EQU(State_OutfeedingConveyorReverse,CTXXXX.State) ,EQU(State_OutfeedingChainForward,CTXXXX.State) ,EQU(State_OutfeedingChainReverse,CTXXXX.State) ,NEQ(Sys_Mode_CycleStarted,CTXXXX.Mode) EQU(State_WaitingForPart,CTXXXX.State) ][MOV(0,CTXXXX_Infeed_Loc) ,MOV(0,CTXXXX_Outfeed_Dest) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Set infeed station priority]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,CTXXXX.Mode)EQU(State_WaitingForPart,CTXXXX.State)[XIC(Infeed_Conv_Fwd_Priority_Placeholder) MOV(Sys_Infeed_Conv_Fwd_ID,CTXXXX_Infeed_Loc) ,XIC(Infeed_Conv_Rev_Priority_Placeholder) MOV(Sys_Infeed_Conv_Rev_ID,CTXXXX_Infeed_Loc) ,XIC(Infeed_Chain_Fwd_Priority_Placeholder) MOV(Sys_Infeed_Chain_Fwd_ID,CTXXXX_Infeed_Loc) ,XIC(Infeed_Chain_Rev_Priority_Placeholder) MOV(Sys_Infeed_Chain_Rev_ID,CTXXXX_Infeed_Loc) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Set outfeed destination priority]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,CTXXXX.Mode)EQU(State_WaitingForPart,CTXXXX.State)[XIC(Outfeed_Conv_Fwd_Routing_Placeholder) MOV(Sys_Outfeed_Conv_Fwd_ID,CTXXXX_Outfeed_Dest) ,XIC(Outfeed_Conv_Rev_Routing_Placeholder) MOV(Sys_Outfeed_Conv_Rev_ID,CTXXXX_Outfeed_Dest) ,XIC(Outfeed_Chain_Fwd_Routing_Placeholder) MOV(Sys_Outfeed_Chain_Fwd_ID,CTXXXX_Outfeed_Dest) ,XIC(Outfeed_Chain_Rev_Routing_Placeholder) MOV(Sys_Outfeed_Chain_Rev_ID,CTXXXX_Outfeed_Dest) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Manual transfer raise logic]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_Manual,CTXXXX.Mode)[XIC(CTXXXX_Transfer_Raise_HMI) ,XIC(CTXXXX_Manual_Transfer_Raise) XIO(CTXXXX_Transfer_Lower_HMI) ]OTE(CTXXXX_Manual_Transfer_Raise);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Manual transfer lower logic]]>
</Comment>
<Text>
<![CDATA[EQU(Sys_Mode_Manual,CTXXXX.Mode)[XIC(CTXXXX_Transfer_Lower_HMI) ,XIC(CTXXXX_Manual_Transfer_Lower) XIO(CTXXXX_Px_Transfer_Down) ]OTE(CTXXXX_Manual_Transfer_Lower);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Clear station faults and warnings with the HMI fault reset pushbutton]]>
</Comment>
<Text>
<![CDATA[XIC(Sys_Alm_Reset_HMI)[CLR(CTXXXX.Error) ,CLR(CTXXXX.Warning) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[If there is an active fault cycle stop the station]]>
</Comment>
<Text>
<![CDATA[NEQ(CTXXXX.Error,0)EQU(Sys_Mode_CycleStarted,CTXXXX.Mode)MOV(Sys_Mode_CycleStopped,CTXXXX.Mode);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Station faults]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIO(Safety_PowerOn_Placeholder.DN)OTL(CTXXXX.Error.0);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,CTXXXX.Mode)EQU(State_WaitingForPart,CTXXXX.State)[XIC(CTXXXX_FE_Conv) ,XIC(CTXXXX_RE_Conv) ,XIC(CTXXXX_FE_Chain) ,XIC(CTXXXX_RE_Chain) ]TON(CTXXXX_Part_Found_Flt,?,?)XIC(CTXXXX_Part_Found_Flt.DN)OTL(CTXXXX.Error.1);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,CTXXXX.Mode)LIM(State_WaitingForOperator,CTXXXX.State,State_WaitingForDownstream)[EQU(Sys_Infeed_Conv_Fwd_ID,CTXXXX_Infeed_Loc) XIO(CTXXXX_FE_Conv) ,EQU(Sys_Infeed_Conv_Rev_ID,CTXXXX_Infeed_Loc) XIO(CTXXXX_RE_Conv) ,EQU(Sys_Infeed_Chain_Fwd_ID,CTXXXX_Infeed_Loc) XIO(CTXXXX_FE_Chain) ,EQU(Sys_Infeed_Chain_Rev_ID,CTXXXX_Infeed_Loc) XIO(CTXXXX_RE_Chain) ]TON(CTXXXX_Part_Lost_Flt,?,?)XIC(CTXXXX_Part_Lost_Flt.DN)OTL(CTXXXX.Error.2);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[EQU(Sys_Mode_CycleStarted,CTXXXX.Mode)[EQU(State_InfeedingConveyorForward,CTXXXX.State) XIC(CTXXXX_Conv_Run) ,EQU(State_InfeedingConveyorReverse,CTXXXX.State) XIC(CTXXXX_Conv_Dir) ,EQU(State_InfeedingChainForward,CTXXXX.State) XIC(CTXXXX_Chain_Run) ,EQU(State_InfeedingChainReverse,CTXXXX.State) XIC(CTXXXX_Chain_Dir) ]TON(CTXXXX_Part_Load_Flt,?,?)XIC(CTXXXX_Part_Load_Flt.DN)OTL(CTXXXX.Error.3);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(IOLMaster_Connection_Faulted_Placeholder)OTL(CTXXXX.Error.5);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(Safety_PowerOn_Placeholder.DN)[XIO(CTXXXX_Sol_Transfer_Up) XIO(CTXXXX_Px_Transfer_Down) ,XIC(CTXXXX_Sol_Transfer_Up) XIO(CTXXXX_Px_Transfer_Up) ]TON(CTXXXX_Lift_Timeout_Flt,?,?)XIC(CTXXXX_Lift_Timeout_Flt.DN)OTL(CTXXXX.Error.10);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Station warnings]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(CTXXXX.Start_HMI)NEQ(CTXXXX.Error,0)OTL(CTXXXX.Warning.0);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[EQU(Sys_Mode_Manual,CTXXXX.Mode)XIC(CTXXXX.SetState_PartClear_HMI)[XIC(CTXXXX_FE_Conv) ,XIC(CTXXXX_RE_Conv) ,XIC(CTXXXX_FE_Chain) ,XIC(CTXXXX_RE_Chain) ]OTL(CTXXXX.Warning.1);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[EQU(Sys_Mode_Manual,CTXXXX.Mode)XIC(CTXXXX.SetState_PartPresent_HMI)[EQU(Sys_Infeed_Conv_Fwd_ID,CTXXXX_Infeed_Loc) XIO(CTXXXX_FE_Conv) ,EQU(Sys_Infeed_Conv_Rev_ID,CTXXXX_Infeed_Loc) XIO(CTXXXX_RE_Conv) ,EQU(Sys_Infeed_Chain_Fwd_ID,CTXXXX_Infeed_Loc) XIO(CTXXXX_FE_Chain) ,EQU(Sys_Infeed_Chain_Rev_ID,CTXXXX_Infeed_Loc) XIO(CTXXXX_RE_Chain) ]OTL(CTXXXX.Warning.2);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
